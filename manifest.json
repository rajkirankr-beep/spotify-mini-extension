{
  "manifest_version": 3,
  "name": "Spotify Glass Widget",
  "version": "1.0.0",
  "description": "Minimal glassmorphic Spotify mini-player with sideways queue peek.",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Spotify Glass Widget"
  }
}
